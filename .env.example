# ─── Database ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=srinamo
POSTGRES_PASSWORD=srinamo_secret_change_me
POSTGRES_DB=srinamo_pms
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=another-long-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── MinIO (S3-compatible) ───────────────────────────
MINIO_ROOT_USER=srinamo_minio
MINIO_ROOT_PASSWORD=minio_secret_change_me
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=srinamo-documents
MINIO_USE_SSL=false

# ─── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── n8n ─────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_secret_change_me
N8N_WEBHOOK_URL=http://n8n:5678
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=change-me-webhook-secret
WHATSAPP_ENABLED=false
RESORT_MAP_URL=https://maps.app.goo.gl/srinamofarms
REVIEW_URL=https://g.page/r/srinamofarms/review
ICAL_FEED_TOKEN=srinamo-ical-change-me
ICAL_IMPORT_URL=

# ─── App ─────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
RESORT_NAME=SriNamo Farms Resort
RESORT_GSTIN=
RESORT_ADDRESS=
RESORT_PHONE=
RESORT_EMAIL=
