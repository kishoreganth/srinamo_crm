generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  INSPECTED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum GuestSource {
  WALK_IN
  PHONE
  ONLINE
  OTA
  WHATSAPP
  REFERRAL
  PARTNER
  IMPORT
}

enum BookingSource {
  WALK_IN
  PHONE
  ONLINE
  OTA
}

enum IdType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  RAZORPAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum OrderType {
  ROOM_SERVICE
  DINE_IN
  WALK_IN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum HousekeepingTaskType {
  CLEANING
  INSPECTION
  MAINTENANCE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DayType {
  WEEKDAY
  WEEKEND
  ALL
}

enum ActivityBookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model RoomType {
  id           String     @id @default(uuid())
  name         String     @unique
  description  String?
  maxOccupancy Int
  basePrice    Decimal    @db.Decimal(10, 2)
  amenities    Json       @default("[]")
  images       Json       @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  rooms        Room[]
  ratePlans    RatePlan[]
}

model Room {
  id               String             @id @default(uuid())
  roomTypeId       String
  roomNumber       String             @unique
  floor            Int
  status           RoomStatus         @default(AVAILABLE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  roomType         RoomType           @relation(fields: [roomTypeId], references: [id])
  bookings         Booking[]
  housekeepingTasks HousekeepingTask[]

  @@index([roomTypeId])
  @@index([status])
  @@index([floor])
}

model Guest {
  id             String            @id @default(uuid())
  firstName      String
  lastName       String
  phone          String
  email          String?
  address        String?
  city           String?
  state          String?
  idType         IdType?
  idNumber       String?
  idDocumentUrl  String?
  dateOfBirth    DateTime?
  anniversary    DateTime?
  notes          String?
  source         GuestSource?
  whatsappConsent Boolean          @default(true)
  dnd            Boolean           @default(false)
  lastStayOccasion String?
  totalStays     Int               @default(0)
  totalSpent     Decimal           @default(0) @db.Decimal(12, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  bookings       Booking[]
  foodOrders     FoodOrder[]
  activityBookings ActivityBooking[]

  @@index([phone])
  @@index([email])
  @@index([idNumber])
  @@index([firstName, lastName])
}

model Booking {
  id              String            @id @default(uuid())
  bookingCode     String            @unique
  guestId         String
  roomId          String
  checkIn         DateTime
  checkOut        DateTime
  adults          Int               @default(1)
  children        Int               @default(0)
  status          BookingStatus     @default(CONFIRMED)
  source          BookingSource     @default(WALK_IN)
  totalAmount     Decimal           @db.Decimal(12, 2)
  specialRequests String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  guest           Guest             @relation(fields: [guestId], references: [id])
  room            Room              @relation(fields: [roomId], references: [id])
  payments        Payment[]
  invoices        Invoice[]
  folioItems      FolioItem[]
  foodOrders      FoodOrder[]
  activityBookings ActivityBooking[]

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([guestId])
  @@index([roomId])
  @@index([bookingCode])
}

model RatePlan {
  id         String   @id @default(uuid())
  roomTypeId String
  name       String
  startDate  DateTime
  endDate    DateTime
  dayType    DayType  @default(ALL)
  price      Decimal  @db.Decimal(10, 2)
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([roomTypeId])
  @@index([startDate, endDate])
  @@index([isActive])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
}

model Invoice {
  id            String   @id @default(uuid())
  bookingId     String
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(12, 2)
  cgst          Decimal  @db.Decimal(12, 2)
  sgst          Decimal  @db.Decimal(12, 2)
  igst          Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  guestGstin    String?
  isGstInvoice  Boolean  @default(false)
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([invoiceNumber])
}

model FolioItem {
  id          String   @id @default(uuid())
  bookingId   String
  description String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([category])
}

model MenuItem {
  id          String          @id @default(uuid())
  name        String
  category    String
  description String?
  price       Decimal         @db.Decimal(10, 2)
  isVeg       Boolean
  isAvailable Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  FoodOrderItem[]

  @@index([category])
  @@index([isAvailable])
}

model FoodOrder {
  id          String          @id @default(uuid())
  bookingId   String?
  guestId     String?
  orderType   OrderType
  status      OrderStatus     @default(PENDING)
  totalAmount Decimal         @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  guest       Guest?          @relation(fields: [guestId], references: [id])
  items       FoodOrderItem[]

  @@index([bookingId])
  @@index([status])
  @@index([orderType])
}

model FoodOrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  notes      String?
  order      FoodOrder @relation(fields: [orderId], references: [id])
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model HousekeepingTask {
  id          String               @id @default(uuid())
  roomId      String
  taskType    HousekeepingTaskType
  status      TaskStatus           @default(PENDING)
  assignedTo  String?
  notes       String?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  room        Room                 @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([status])
  @@index([taskType])
}

model Activity {
  id              String            @id @default(uuid())
  name            String
  description     String?
  price           Decimal           @db.Decimal(10, 2)
  maxParticipants Int
  duration        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookings        ActivityBooking[]

  @@index([isActive])
}

model ActivityBooking {
  id            String                @id @default(uuid())
  activityId    String
  guestId       String
  bookingId     String?
  scheduledDate DateTime
  participants  Int                   @default(1)
  status        ActivityBookingStatus @default(CONFIRMED)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  activity      Activity              @relation(fields: [activityId], references: [id])
  guest         Guest                 @relation(fields: [guestId], references: [id])
  booking       Booking?              @relation(fields: [bookingId], references: [id])

  @@index([activityId])
  @@index([guestId])
  @@index([scheduledDate])
  @@index([status])
}
